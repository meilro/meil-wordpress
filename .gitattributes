* text=auto eol=lf

# Keep dev files out of the release zip (git archive)
.gitattributes export-ignore
.gitignore export-ignore
.phpcs.xml.dist export-ignore
README.md export-ignore
.wordpress-org export-ignore

# Translations come from translate.wordpress.org. The .po and .mo stay here to import there.
languages/*.po export-ignore
languages/*.mo export-ignore
