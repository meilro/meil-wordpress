<?xml version="1.0"?>
<ruleset name="meil">
    <description>WPCS ruleset for the meil.ro WordPress plugin.</description>
    <file>.</file>
    <arg name="extensions" value="php"/>
    <arg name="basepath" value="."/>
    <arg value="sp"/>
    <rule ref="WordPress">
        <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
    </rule>
    <config name="minimum_supported_wp_version" value="5.9"/>
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array" value="meil"/>
        </properties>
    </rule>
</ruleset>
