msgstr "API-ul meil a răspuns cu HTTP %d."

#: includes/class-meil-confirm.php:114
msgid "Thank you, your subscription is confirmed."
msgstr "Mulțumim, abonarea ta este confirmată."

#: includes/class-meil-confirm.php:117
msgid "Your subscription was already confirmed. Thank you!"
msgstr "Abonarea ta era deja confirmată. Mulțumim!"

#: includes/class-meil-confirm.php:120
msgid ""
"This confirmation link has expired. Please sign up again to get a new one."
msgstr ""
"Linkul de confirmare a expirat. Abonează-te din nou ca să primești unul nou."

#: includes/class-meil-confirm.php:123
msgid ""
"This confirmation link is not valid. Please use the button in the email we "
"sent you, or sign up again."
msgstr ""
"Linkul de confirmare nu este valid. Folosește butonul din e-mailul primit de "
"la noi sau abonează-te din nou."

#: includes/class-meil-confirm.php:126
msgid ""
"Sorry, we could not confirm your subscription right now. Please try again in "
"a few minutes."
msgstr ""
"Ne pare rău, nu am putut confirma abonarea acum. Încearcă din nou în câteva "
"minute."

#. translators: %s: the visitor's email address
#: includes/class-meil-confirm.php:130
#, php-format
msgid "Press the button to confirm that you want to receive our emails at %s."
msgstr ""
"Apasă butonul ca să confirmi că vrei să primești e-mailurile noastre la %s."

#: includes/class-meil-confirm.php:133
msgid "Press the button to confirm your subscription."
msgstr "Apasă butonul ca să confirmi abonarea."

#: includes/class-meil-confirm.php:136
msgid "You are subscribing to:"
msgstr "Te abonezi la:"

#: includes/class-meil-confirm.php:139
msgid "Confirm my subscription"
msgstr "Confirm abonarea"

#: includes/class-meil-confirm.php:278
msgid ""
"This is where visitors confirm their subscription: they arrive here from the "
"button in the confirmation email. Only you see this note."
msgstr ""
"Aici își confirmă vizitatorii abonarea: ajung pe această pagină din butonul "
"din e-mailul de confirmare. Doar tu vezi această notă."

